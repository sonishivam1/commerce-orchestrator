# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/cdo

# ── Queue / Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth ──────────────────────────────────────────────────────
# A 64-char hex string (256-bit AES key).  Generate with:
#   openssl rand -hex 32
CREDENTIAL_KEY=change_me_64_char_hex_string_replace_with_real_key_here_000000

# HS256 JWT secret (minimum 32 characters)
JWT_SECRET=change_me_at_least_32_chars_for_hs256_jwt_signing

# Token expiry (e.g. 7d, 24h, 3600s)
JWT_EXPIRES_IN=7d

# ── App ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
