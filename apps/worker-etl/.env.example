# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/cdo

# ── Queue / Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Encryption ────────────────────────────────────────────────
# Must match the CREDENTIAL_KEY used by the API service
CREDENTIAL_KEY=change_me_64_char_hex_string_replace_with_real_key_here_000000

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
