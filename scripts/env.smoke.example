# Copy this file to the ROOT .env and fill in real credentials.
# NEVER commit the filled-in .env — it is already listed in .gitignore.
#
# Usage (automatic via pnpm smoke — .env is loaded by Node 22 --env-file):
#   pnpm smoke
#
# Manual usage (e.g. PowerShell):
#   $env:CTP_PROJECT_KEY="your-key"; ... ; pnpm smoke
#   -- or --
#   Get-Content .env | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)') { [System.Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) } }
#   pnpm smoke

# ─── Commercetools ────────────────────────────────────────────────────────────
CTP_PROJECT_KEY=your-ct-project-key
CTP_CLIENT_ID=your-ct-client-id
CTP_CLIENT_SECRET=your-ct-client-secret
CTP_API_URL=https://api.europe-west1.gcp.commercetools.com
CTP_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com

# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_SHOP=your-shop-name           # subdomain only, no .myshopify.com
SHOPIFY_CLIENT_ID=your-shopify-client-id
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret   # shpss_xxx — never commit

# A Shopify Admin API access token is obtained automatically at smoke startup
# via the client_credentials grant. Do NOT add SHOPIFY_ACCESS_TOKEN here.

# ─── Optional ─────────────────────────────────────────────────────────────────
# SHOPIFY_LOCATION_ID=gid://shopify/Location/123   # needed for inventory waves
# SMOKE_LIMIT=2   # items per entity type (0 = all; default is 2 for a quick smoke)
