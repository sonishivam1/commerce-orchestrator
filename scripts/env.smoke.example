# Copy this file to scripts/env.smoke and fill in real credentials.
# NEVER commit the filled-in copy — add env.smoke to .gitignore.
#
# Usage:
#   source scripts/env.smoke && npx ts-node -r tsconfig-paths/register scripts/e2e-smoke.ts

# ─── Commercetools ────────────────────────────────────────────────────────────
CT_PROJECT_KEY=your-ct-project-key
CT_CLIENT_ID=your-ct-client-id
CT_CLIENT_SECRET=your-ct-client-secret
CT_API_URL=https://api.europe-west1.gcp.commercetools.com
CT_AUTH_URL=https://auth.europe-west1.gcp.commercetools.com

# ─── Shopify ──────────────────────────────────────────────────────────────────
SHOPIFY_SHOP_NAME=your-shop-name          # subdomain only, no .myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxx

# ─── Optional ─────────────────────────────────────────────────────────────────
# SHOPIFY_LOCATION_ID=gid://shopify/Location/123   # needed for inventory waves
# SMOKE_LIMIT=2   # items per entity type (0 = all; default is 2 for a quick smoke)
