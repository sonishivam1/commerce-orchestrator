{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "jsx": "react-jsx",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "rootDir": "src",
        "composite": true,
        "declaration": true,
        "baseUrl": ".",
        "paths": {
            "@cdo/ui/*": ["src/*"]
        }
    },
    "include": [
        "src"
    ],
    "exclude": [
        "dist",
        "node_modules"
    ]
}